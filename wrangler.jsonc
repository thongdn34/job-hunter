{
  // Cloudflare Workers deployment (OpenNext). Node.js deployments ignore this file.
  // Setup, costs and limits: docs/DEPLOYMENT.md → "Cloudflare Workers".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-hunter",
  // Custom entry: Cloudflare Access check + /api/internal guard in front of the OpenNext handler,
  // plus the GenerationWorkflow class.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-20",
  // esbuild's keep_names wraps functions in a __name() helper; functions serialized into inline
  // <script>s (e.g. the next-themes bootstrap) then throw "__name is not defined" in the browser.
  "keep_names": false,
  // global_fetch_strictly_public: fetch() can only reach public addresses (SSRF protection for
  // job-URL extraction at connect time).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-hunter",
      // `pnpm cf:d1:create` prints the id; paste it here before the first remote migration/deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "name": "job-hunter-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow",
    },
  ],
  // Workers Rate Limiting (free): 10 job-URL extractions per minute per client IP.
  "ratelimits": [
    {
      "name": "JD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    // Cloudflare only routes this Worker's own hostnames to it, so the DNS-rebinding Host check is
    // not needed; the Origin/CSRF check in src/proxy.ts still applies.
    "ALLOWED_HOSTS": "*",
    // Cloudflare Access (Zero Trust) protects the app — set both (see docs/DEPLOYMENT.md), or set
    // ALLOW_UNAUTHENTICATED=true in .dev.vars for local previews only.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
  },
  "observability": { "enabled": true },
}
