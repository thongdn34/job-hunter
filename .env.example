# Node.js runtime (pnpm dev / pnpm start / Docker). For Cloudflare Workers use .dev.vars
# (see .dev.vars.example) and `wrangler secret put` — docs/DEPLOYMENT.md.

# --- Database -------------------------------------------------------------
# SQLite for local-first development (path is relative to the project root).
DATABASE_URL="file:./prisma/dev.db"

# --- Request guard (src/proxy.ts) ------------------------------------------
# Only localhost / 127.0.0.1 / [::1] Host names are served (DNS-rebinding protection), and
# cross-origin POST/PUT/DELETE requests are refused. Comma-separated extra host names (optionally
# host:port) when the app is reached under another name, e.g. behind a reverse proxy or via a LAN IP.
# ALLOWED_HOSTS=jobs.example.com,192.168.1.20:3000

# --- AI provider (server-side only; never prefix with NEXT_PUBLIC_) --------
# openai | anthropic | openai-compatible | mock   (empty = auto-detect from keys below)
AI_PROVIDER=
# Optional model override, e.g. gpt-5-mini, claude-sonnet-5-5, llama-3.3-70b
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, vLLM, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional Cloudflare AI Gateway in front of OpenAI / Anthropic (response caching, cost analytics,
# rate limits, retries). Works from any runtime, not only Cloudflare Workers.
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>
# AI_GATEWAY_TOKEN=          # only for authenticated gateways

# Testing only: comma-separated section keys the mock provider should fail.
# MOCK_FAIL_SECTIONS=company,coding
# MOCK_MALFORMED_ONCE_SECTIONS=bilingual   # first attempt returns invalid output (tests repair)
# MOCK_RATE_LIMIT_ONCE_SECTIONS=intro      # first attempt throws a 429 (tests backoff)
# MOCK_DELAY_MS=200                        # artificial per-section latency for demos

# Job URL fetching: when a site blocks direct requests (LinkedIn blocks datacenter IPs), read the page
# through Jina Reader instead. This sends the job URL to a third party, so it is off by default.
# JD_READER_FALLBACK=jina
# JINA_API_KEY=   # optional, raises Jina's rate limit
