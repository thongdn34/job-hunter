{
  "name": "job-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate && node scripts/prepare-prisma-workerd.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate && node scripts/prepare-prisma-workerd.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "cf:build": "node scripts/prepare-prisma-workerd.mjs && opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && wrangler dev --port 8787",
    "cf:deploy": "pnpm cf:migrations --check && pnpm cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types cloudflare/worker-configuration.d.ts --env-file .dev.vars.example --strict-vars=false",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:migrations": "node scripts/sync-d1-migrations.mjs",
    "cf:d1:create": "wrangler d1 create job-hunter",
    "cf:d1:migrate:local": "node scripts/sync-d1-migrations.mjs && wrangler d1 migrations apply job-hunter --local",
    "cf:d1:migrate:remote": "node scripts/sync-d1-migrations.mjs && wrangler d1 migrations apply job-hunter --remote",
    "cf:smoke": "node scripts/cf-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.110",
    "@ai-sdk/openai": "^4.0.125",
    "@ai-sdk/openai-compatible": "^3.0.96",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.9",
    "@opennextjs/cloudflare": "1.20.19",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.108.4",
    "ai": "^7.0.183",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.81.0",
    "marked": "^18.3.0",
    "mermaid": "^12.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.2",
    "wrangler": "4.168.0"
  },
  "packageManager": "pnpm@10.34.7"
}
